{
  "name": "mcportal",
  "version": "0.3.0",
  "description": "MCPortal: a personal, agent-composed workspace delivered as an MCP server with an MCP Apps UI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/mcportal.mjs",
    "stdio": "node bin/mcportal.mjs --stdio",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "snapshot": "node scripts/snapshot.ts snapshot.html",
    "demo": "MCPORTAL_FIXTURES=1 MCPORTAL_DATA_DIR=.demo-data node bin/mcportal.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "railway": "^3.12.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "mcportal": "bin/mcportal.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
