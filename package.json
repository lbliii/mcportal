{
  "name": "mcportal",
  "version": "0.11.0",
  "description": "MCPortal: a personal, agent-composed workspace delivered as an MCP server with an MCP Apps UI.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/mcportal.mjs",
    "stdio": "node bin/mcportal.mjs --stdio",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "ops:check": "node scripts/ops-check.ts",
    "snapshot": "node scripts/snapshot.ts snapshot.html",
    "brand": "node scripts/brand.ts",
    "demo": "MCPORTAL_FIXTURES=1 MCPORTAL_DATA_DIR=.demo-data node bin/mcportal.mjs",
    "typecheck": "tsc --noEmit && node scripts/check-ui.ts",
    "typecheck:ui": "node scripts/check-ui.ts",
    "design": "node scripts/design.ts",
    "design:check": "node scripts/design.ts --check",
    "check": "npm run typecheck && npm run design:check && npm test",
    "footprint": "node scripts/footprint.ts",
    "eval:tools": "node scripts/eval-tools.ts",
    "eval:recall": "node scripts/eval-recall.ts",
    "release": "node scripts/release.ts",
    "support:check": "node scripts/check-support.ts",
    "planning:check": "node scripts/planning-horizon.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "opentype.js": "^2.0.0",
    "railway": "^3.12.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "mcportal": "bin/mcportal.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
