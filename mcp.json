{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mcportal": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/mcportal.mjs",
        "--stdio"
      ],
      "env": {
        "MCPORTAL_DATA_DIR": "${PLUGIN_DATA}/mcportal"
      }
    }
  }
}
