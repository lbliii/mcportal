# ---- Network -------------------------------------------------------------
# Interface to bind. Defaults to 127.0.0.1 (local only). The Docker image sets 0.0.0.0.
# On anything but loopback the server refuses to start without auth (below).
HOST=
PORT=8787
# Public base URL (used for OAuth metadata and the Host allowlist).
# Railway: derived automatically from RAILWAY_PUBLIC_DOMAIN.
MCPORTAL_PUBLIC_URL=
# Extra hostnames to accept in the Host header (comma-separated).
MCPORTAL_ALLOWED_HOSTS=
# Browser origins allowed to call /mcp directly (comma-separated). Rarely needed.
MCPORTAL_ALLOWED_ORIGINS=

# ---- Auth: pick one (or both) --------------------------------------------
# 1) OAuth with GitHub sign-in: works as a Claude custom connector, multi-user.
#    Create a GitHub OAuth App with callback URL <public URL>/oauth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#    Optional: only these GitHub logins may sign in (comma-separated). Empty = anyone.
MCPORTAL_ALLOWED_GITHUB_USERS=
# 2) Static bearer token: single user, for clients that support custom headers.
MCPORTAL_TOKEN=
# Profile id used for static-token and unauthenticated (local) access.
MCPORTAL_USER=
# Escape hatch: serve without auth on a non-loopback interface. Don't.
MCPORTAL_ALLOW_UNAUTHENTICATED=

# ---- Data & sources --------------------------------------------------------
# Profiles and OAuth state. Locally ~/.mcportal; on Railway a volume at /data.
MCPORTAL_DATA_DIR=
# Optional GitHub token for higher API rate limits on GitHub panels (no scopes needed).
GITHUB_TOKEN=
# 1 = serve canned data from test/fixtures (offline demos).
MCPORTAL_FIXTURES=
