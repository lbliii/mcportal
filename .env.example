# Every variable is documented in docs/reference/configuration.md.

# ---- Network -------------------------------------------------------------
# Interface to bind. Defaults to 127.0.0.1 (local only). The Docker image sets 0.0.0.0.
# On anything but loopback the server refuses to start without auth (below).
HOST=
PORT=8787
# Public base URL (used for OAuth metadata and the Host allowlist).
# Railway: derived automatically from RAILWAY_PUBLIC_DOMAIN.
MCPORTAL_PUBLIC_URL=
# Extra hostnames to accept in the Host header (comma-separated).
MCPORTAL_ALLOWED_HOSTS=
# Browser origins allowed to call /mcp directly (comma-separated). Rarely needed.
MCPORTAL_ALLOWED_ORIGINS=
# 1 = take the client address from X-Forwarded-For (on by default on Railway).
MCPORTAL_TRUST_PROXY=

# ---- Auth: pick one (or both) --------------------------------------------
# 1) OAuth with GitHub sign-in: works as a Claude custom connector, multi-user.
#    Create a GitHub OAuth App with callback URL <public URL>/oauth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#    Who can sign in. Admins (logins or numeric ids) always can, and can use
#    `mcportal admin …` (invite, suspend). Invite others with
#    `mcportal admin invite <login>`. MCPORTAL_ALLOWED_GITHUB_USERS is the older
#    allowlist and still works. With none of these set, anyone can sign in;
#    set MCPORTAL_OPEN_SIGNUP=1 to allow anyone even when admins are set.
MCPORTAL_ADMINS=
MCPORTAL_ALLOWED_GITHUB_USERS=
MCPORTAL_OPEN_SIGNUP=
# 2) Static bearer token: single user, for clients that support custom headers.
MCPORTAL_TOKEN=
# Profile id used for static-token and unauthenticated (local) access.
MCPORTAL_USER=
# Escape hatch: serve without auth on a non-loopback interface. Don't.
MCPORTAL_ALLOW_UNAUTHENTICATED=

# ---- Data & sources --------------------------------------------------------
# Profiles and OAuth state. Locally ~/.mcportal; on Railway a volume at /data.
MCPORTAL_DATA_DIR=
# Postgres for profiles and OAuth state (hosted). When set, the HTTP server uses
# it instead of files, importing any files from MCPORTAL_DATA_DIR once. Stdio
# (local) always uses files. On Railway: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=
# Optional GitHub token for higher API rate limits on GitHub panels (no scopes needed).
GITHUB_TOKEN=
# 1 = serve canned data from test/fixtures (offline demos).
MCPORTAL_FIXTURES=
# The hosted MCPortal a local one signs in to (link_account). Default: the public one.
MCPORTAL_HOSTED_URL=

# ---- Usage limits (HTTP server; local stdio is unlimited) ------------------
# Units per user per minute / per day, and for all users per day. Tools cost
# units by outbound work; see docs/reference/tools.md for each tool's cost.
# Defaults: 120 / 3000 / 60000.
MCPORTAL_LIMIT_PER_MINUTE=
MCPORTAL_LIMIT_PER_DAY=
MCPORTAL_LIMIT_GLOBAL_PER_DAY=


# Optional artist search and dated concert watches. Public iCalendar watches need no key.
# The key stays on the server; city/country filters are sent to Ticketmaster.
TICKETMASTER_API_KEY=

# ---- Public pages ---------------------------------------------------------
# The landing page, /privacy, /terms, /support and /security. Who runs this
# server, where support and security reports go (must be an email address),
# the law the terms are under, and an optional support link that overrides
# mailto:. If you run a modified copy, AGPL-3.0 asks you to offer its source:
# set MCPORTAL_SOURCE_URL.
MCPORTAL_OPERATOR=

MCPORTAL_CONTACT_EMAIL=
MCPORTAL_JURISDICTION=
MCPORTAL_SUPPORT_URL=
MCPORTAL_SOURCE_URL=

# ---- Logs and labs --------------------------------------------------------
# debug | info | warn | error, and text | json.
MCPORTAL_LOG_LEVEL=
MCPORTAL_LOG_FORMAT=
# Experimental features, comma-separated (currently: frontpage).
MCPORTAL_LABS=
