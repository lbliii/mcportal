# Port for the HTTP transport (Railway sets this automatically)
PORT=8787

# Where profiles are stored. Locally defaults to ~/.mcportal; on Railway use a volume at /data.
MCPORTAL_DATA_DIR=

# Shared secret for the HTTP endpoint. Clients send "Authorization: Bearer <token>".
# Required for any deployment reachable from the internet.
MCPORTAL_TOKEN=

# Optional: GitHub token for higher API rate limits (no scopes needed for public data).
GITHUB_TOKEN=

# Optional: comma-separated browser origins allowed to call /mcp (DNS-rebinding protection).
MCPORTAL_ALLOWED_ORIGINS=

# Set to 1 to serve canned data from test/fixtures (offline demos).
MCPORTAL_FIXTURES=
